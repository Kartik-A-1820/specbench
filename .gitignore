# specbench — .gitignore
#
# Kept in the repository: source, tests, docs, figures, and the measurement
# files under results/ (the numbers are the point of the project).
# Excluded: model weights, trained checkpoints, cached hidden states, the
# virtual environment, caches, and run logs.

# ---------------------------------------------------------------------------
# Model weights (multi-GB, downloaded by scripts/download_models.py)
# ---------------------------------------------------------------------------
models/

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
.env
.env.*

# ---------------------------------------------------------------------------
# Python caches and build output
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# ---------------------------------------------------------------------------
# Test caches
# ---------------------------------------------------------------------------
.pytest_cache/
.cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Phase 2 (EAGLE) intermediates.
#
# results/checkpoints/ holds ~3.8 GB of trained-head weights and
# results/hidden_states/ the cached target features they were fitted to.
# Both are reproducible from scripts/run_phase2_collect.py and
# scripts/run_phase2_train.py. The *summaries* of these runs are committed.
# ---------------------------------------------------------------------------
results/checkpoints/
results/hidden_states/

# Torch/checkpoint blobs anywhere in the tree, as a backstop.
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.npy
*.npz

# ---------------------------------------------------------------------------
# Run logs and stage markers (machine- and run-specific)
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Local helper scripts that are not part of the project
# ---------------------------------------------------------------------------
finish_cleanup.bat
push_to_github.bat
scrub_build_scripts.bat

# ---------------------------------------------------------------------------
# OS and editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~
